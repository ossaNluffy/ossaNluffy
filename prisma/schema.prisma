generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}




model Category {
  id         Int     @id @default(autoincrement())
  slug       String  @unique
  name       String
  shortDesc  String? @db.Text
  longDesc   String? @db.Text
  coverImage String?
  order      Int     @default(0)
  isFeatured Boolean @default(false)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  events Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id         Int         @id @default(autoincrement())
  slug       String      @unique
  title      String
  subtitle   String?
  status     EventStatus @default(DRAFT)
  eventDate  DateTime?
  city       String?
  venue      String?
  coverImage String?
  gallery    String[] @default([])
  brief       String? @db.Text
  concept     String? @db.Text
  realization String? @db.Text
  result      String? @db.Text
  testimonial String? @db.Text
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  isFeatured Boolean @default(false)
  order      Int     @default(0)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
